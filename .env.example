# Copy this file to .env and fill it in. .env stays on your PC (git-ignored). Never put keys in code or the extension.
# Keep comments on their own lines: anything after "=" is read as the value.

# Required. Claude writes the read, the takes and the answers: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Required. Solana data. The free plan works: https://www.helius.dev (looks like https://mainnet.helius-rpc.com/?api-key=...)
HELIUS_RPC_URL=

# Optional. Voice mode and speech to text: https://elevenlabs.io (text mode works without it)
ELEVENLABS_API_KEY=
# Optional. X search, so pillbud can check the coin's tweet and its X account: https://twitterapi.io
TWITTERAPI_IO_KEY=
# Optional. The official X API instead (an app's Bearer Token from https://developer.x.com)
X_BEARER_TOKEN=
# Optional. How many Helius calls a second your plan allows (default 10; the Developer plan allows 50)
HELIUS_RPS=
# Optional. Also read keys from this file (for keys you keep in one shared place)
PILLBUD_ENV_FILE=
