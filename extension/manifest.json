{
  "manifest_version": 3,
  "name": "pillbud: the coin you're at",
  "version": "0.1.0",
  "description": "Tells the pillbud desktop app which Solana coin your active tab is on (pump.fun, DexScreener, GMGN, Axiom, Photon, Birdeye, Solscan). Sends only the page URL, only to localhost.",
  "action": { "default_title": "pillbud", "default_popup": "popup.html", "default_icon": { "16": "icons/pill16.png", "32": "icons/pill32.png", "48": "icons/pill48.png" } },
  "icons": { "16": "icons/pill16.png", "48": "icons/pill48.png", "128": "icons/pill128.png" },
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://pump.fun/*", "https://*.pump.fun/*",
    "https://dexscreener.com/*", "https://*.dexscreener.com/*",
    "https://gmgn.ai/*", "https://*.gmgn.ai/*",
    "https://axiom.trade/*", "https://*.axiom.trade/*",
    "https://photon-sol.tinyastro.io/*",
    "https://birdeye.so/*", "https://*.birdeye.so/*",
    "https://solscan.io/*", "https://*.solscan.io/*",
    "http://127.0.0.1:47321/*"
  ]
}
